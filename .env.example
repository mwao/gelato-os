# Copy to `.env` for local development (never commit real keys).
#
# VITE_SUPABASE_URL = Project Settings → API → "Project URL" only:
#   https://<ref>.supabase.co
# Do NOT append /rest/v1 (that is the DB API path; including it breaks Auth URLs).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase Dashboard (Phase 2 Auth) ---
# Authentication → Providers → Email: enable Email/password.
# For local dev, turn OFF "Confirm email" so signup returns a session immediately.
# (If ON, the mail link points at Site URL e.g. localhost — fine on same PC only.)
# Authentication → URL Configuration:
#   Site URL: http://localhost:5173 (and your production URL on Vercel).
#   Redirect URLs: add the same URLs so magic links / OAuth redirects work later.
